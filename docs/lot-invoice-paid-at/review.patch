diff --git a/supabase/migrations/20261022194733_add_invoice_paid_at_guarded.sql b/supabase/migrations/20261022194733_add_invoice_paid_at_guarded.sql
new file mode 100644
index 0000000..3f16066
--- /dev/null
+++ b/supabase/migrations/20261022194733_add_invoice_paid_at_guarded.sql
@@ -0,0 +1,65 @@
+-- Local review only. Apply separately after approval; never replay the INSERT gate.
+BEGIN;
+SET LOCAL lock_timeout = '5s';
+SET LOCAL statement_timeout = '15s';
+SET LOCAL idle_in_transaction_session_timeout = '20s';
+
+-- Serialize schema/policy inspection with the ALTER; lock wait is bounded above.
+LOCK TABLE public.invoices IN ACCESS EXCLUSIVE MODE;
+DO $preflight$
+BEGIN
+  IF NOT EXISTS (
+    SELECT 1 FROM pg_class
+    WHERE oid = 'public.invoices'::regclass AND relkind = 'r'
+      AND relrowsecurity
+  ) THEN
+    RAISE EXCEPTION 'Expected ordinary invoices table with RLS enabled';
+  END IF;
+  IF (SELECT count(*) FROM pg_roles
+      WHERE rolname IN ('anon', 'authenticated')
+        AND NOT rolsuper AND NOT rolbypassrls) <> 2 THEN
+    RAISE EXCEPTION 'Browser roles missing or privileged';
+  END IF;
+  IF EXISTS (
+    SELECT 1 FROM pg_class c JOIN pg_roles r ON r.oid = c.relowner
+    WHERE c.oid = 'public.invoices'::regclass
+      AND (pg_has_role('anon', r.oid, 'MEMBER')
+        OR pg_has_role('authenticated', r.oid, 'MEMBER'))
+  ) THEN
+    RAISE EXCEPTION 'Browser role can reach invoice owner';
+  END IF;
+  IF NOT EXISTS (
+    SELECT 1 FROM pg_policy p
+    WHERE p.polrelid = 'public.invoices'::regclass
+      AND p.polname = 'lot_10_3b_6d_4_deny_browser_invoice_insert'
+      AND p.polcmd = 'a' AND NOT p.polpermissive
+      AND p.polqual IS NULL
+      AND pg_get_expr(p.polwithcheck, p.polrelid) = 'false'
+      AND (SELECT array_agg(r.rolname::text ORDER BY r.rolname::text)
+           FROM pg_roles r WHERE r.oid = ANY(p.polroles))
+          = ARRAY['anon', 'authenticated']::text[]
+      AND cardinality(p.polroles) = 2
+  ) THEN
+    RAISE EXCEPTION 'Missing or drifted invoice INSERT gate';
+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM pg_attribute
+      WHERE attrelid = 'public.invoices'::regclass AND attname = 'id'
+        AND atttypid = 'uuid'::regtype AND attnotnull AND NOT attisdropped)
+    OR NOT EXISTS (SELECT 1 FROM pg_attribute
+      WHERE attrelid = 'public.invoices'::regclass AND attname = 'user_id'
+        AND atttypid = 'uuid'::regtype AND attnotnull AND NOT attisdropped)
+    OR NOT EXISTS (SELECT 1 FROM pg_attribute
+      WHERE attrelid = 'public.invoices'::regclass AND attname = 'status'
+        AND atttypid = 'text'::regtype AND NOT attisdropped) THEN
+    RAISE EXCEPTION 'Unexpected invoice identity/payment schema';
+  END IF;
+  IF EXISTS (SELECT 1 FROM pg_attribute
+      WHERE attrelid = 'public.invoices'::regclass AND attname = 'paid_at'
+        AND NOT attisdropped) THEN
+    RAISE EXCEPTION 'paid_at already exists; review schema/history before proceeding';
+  END IF;
+END
+$preflight$;
+
+ALTER TABLE public.invoices ADD COLUMN paid_at timestamptz NULL;
+COMMIT;
diff --git a/tests/invoice-payment-compatibility.test.js b/tests/invoice-payment-compatibility.test.js
new file mode 100644
index 0000000..f1ebbe3
--- /dev/null
+++ b/tests/invoice-payment-compatibility.test.js
@@ -0,0 +1,48 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import test from 'node:test';
+import vm from 'node:vm';
+
+const source = readFileSync(new URL('../src/App.jsx', import.meta.url), 'utf8');
+const handler = source.slice(source.indexOf('async function handleMarkInvoicePaid('), source.indexOf('\nfunction openReminderManager('));
+function harness({ local = false, signedIn = true, error = null } = {}) {
+  const rows = [{ id: 'a', invoice_number: 'A', status: 'draft' }, { id: 'b', invoice_number: 'B', status: 'draft' }];
+  const calls = [];
+  let state = structuredClone(rows), stored, notice, refreshes = 0;
+  const chain = { update(payload) { calls.push(['update', payload]); return this; }, eq(key, value) { calls.push(['eq', key, value]); return this; }, then(resolve) { resolve({ error }); } };
+  const context = vm.createContext({ Date, console: { error() {} }, user: signedIn ? { id: 'owner' } : null,
+    GUEST_INVOICES_KEY: 'guest_invoices', localStorage: { setItem(key, value) { stored = [key, JSON.parse(value)]; } },
+    setGuestInvoices(fn) { state = fn(state); }, setInvoices(fn) { state = fn(state); },
+    setInvoiceNotice(value) { notice = value; }, refreshInvoices() { refreshes++; },
+    supabase: { from(table) { calls.push(['from', table]); return chain; } },
+  });
+  vm.runInContext(handler, context);
+  return { run: (invoice = { ...rows[0], localOnly: local }) => context.handleMarkInvoicePaid(invoice),
+    result: () => ({ state, stored, notice, refreshes, calls }) };
+}
+for (const options of [{ local: true }, { signedIn: false }, {}]) {
+  test(`only selected invoice becomes paid: ${JSON.stringify(options)}`, async () => {
+    const h = harness(options); await h.run();
+    const r = h.result();
+    assert.equal(r.state[0].status, 'paid');
+    assert.ok(!Number.isNaN(Date.parse(r.state[0].paid_at)));
+    assert.equal(r.state[1].status, 'draft');
+    assert.equal(r.state[1].paid_at, undefined);
+    if (options.local || options.signedIn === false) {
+      assert.equal(r.calls.length, 0); assert.equal(r.stored[0], 'guest_invoices');
+    } else {
+      assert.equal(r.stored, undefined);
+      assert.equal(r.calls[0][1], 'invoices');
+      assert.deepEqual(Object.keys(r.calls[1][1]).sort(), ['paid_at', 'status']);
+      assert.deepEqual(r.calls.slice(2), [['eq', 'id', 'a'], ['eq', 'user_id', 'owner']]);
+    }
+  });
+}
+test('remote service error reports failure and refreshes invoices', async () => {
+  const h = harness({ error: { message: 'synthetic rejected write' } }); await h.run();
+  assert.equal(h.result().refreshes, 1);
+  assert.match(h.result().notice, /Impossible/);
+});
+test('missing identifier produces no payment write', async () => {
+  const h = harness(); await h.run({}); assert.equal(h.result().calls.length, 0);
+});
